# Copy this file to .env.local for local development.
# This is a static site — everything built into the bundle is public, so never
# put real secrets here. The Google Client ID and Apps Script URL below are
# meant to be public (they are restricted server-side by Google, not by secrecy).

# URL of the deployed Google Apps Script Web App (see /appsscript and SETUP.md)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxmtJRm13FvJc2_Hj-aZXh60YCidrTvc08xfld-HWyD5cUCE9PsgiCAephcZatScCLu-Q/exec

# OAuth Client ID from Google Cloud Console, used for "Sign in with Google"
# (admin dashboard gate + events form sign-in gate)
VITE_GOOGLE_CLIENT_ID=659480195419-4u7rqo7230nftiphg5tvc3vis759ikhc.apps.googleusercontent.com

# Comma-separated list of Google account emails allowed to see the Admin Dashboard
VITE_ADMIN_EMAILS=madridtamilasociacion@gmail.com

# Optional deep links shown on the Admin Dashboard (leave blank to hide a link)
VITE_ADMIN_DRIVE_ROOT_URL=https://drive.google.com/drive/my-drive
VITE_ADMIN_HOME_SHEET_URL=https://docs.google.com/spreadsheets/d/1ybGO8VoovKRHWIK5TaKjMkaIwnrRCo3Q9mpvzAgIY3Q/edit?gid=0#gid=0
